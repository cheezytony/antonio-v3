# Google Sheets integration for the contact form (src/server/contact.ts),
# via a Google Apps Script Web App bound to the spreadsheet — see README/
# setup notes for how to create and deploy the script.

GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SHEETS_WEBAPP_SECRET=a-long-random-string-you-make-up
